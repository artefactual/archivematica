{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:watch": "run-p type-check \"build-only -- --watch --mode=development\"",
    "test": "vitest run",
    "test:interactive": "vitest",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "check": "run-s lint type-check test build-only",
    "deps": "npx npm-check-updates --interactive"
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.2.1",
    "base64-helpers": "github:artefactual-labs/base64-helpers#v0.1.4",
    "reka-ui": "^2.9.6",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "~10.9.0",
    "glob": "^13.0.6",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "^9.0.9"
    }
  }
}

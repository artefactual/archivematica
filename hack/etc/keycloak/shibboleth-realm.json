{
  "id": "shibboleth",
  "realm": "shibboleth",
  "displayName": "Archivematica Shibboleth development",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "archivematica-attributes",
      "description": "Attributes read by the Archivematica Shibboleth backends, released under their eduPerson/LDAP OIDs so the stock Shibboleth SP attribute map yields the eppn, entitlement, givenName, sn and mail headers.",
      "protocol": "saml",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "eppn",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "urn:oid:1.3.6.1.4.1.5923.1.1.1.6",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "eduPersonPrincipalName"
          }
        },
        {
          "name": "entitlement",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "entitlement",
            "attribute.name": "urn:oid:1.3.6.1.4.1.5923.1.1.1.7",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "eduPersonEntitlement",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "givenName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "urn:oid:2.5.4.42",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "givenName"
          }
        },
        {
          "name": "sn",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "attribute.name": "urn:oid:2.5.4.4",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "sn"
          }
        },
        {
          "name": "mail",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "urn:oid:0.9.2342.19200300.100.1.3",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "mail"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "id": "archivematica-dashboard",
      "clientId": "urn:archivematica:dashboard",
      "name": "Archivematica Dashboard (development)",
      "protocol": "saml",
      "enabled": true,
      "rootUrl": "http://localhost:62080",
      "adminUrl": "http://localhost:62080/Shibboleth.sso/SAML2/POST",
      "redirectUris": [
        "http://localhost:62080/Shibboleth.sso/*",
        "http://127.0.0.1:62080/Shibboleth.sso/*"
      ],
      "frontchannelLogout": false,
      "attributes": {
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true",
        "saml_name_id_format": "username",
        "saml_force_name_id_format": "true",
        "saml_assertion_consumer_url_post": "http://localhost:62080/Shibboleth.sso/SAML2/POST"
      },
      "defaultClientScopes": [
        "archivematica-attributes"
      ],
      "optionalClientScopes": []
    },
    {
      "id": "archivematica-storage-service",
      "clientId": "urn:archivematica:storage-service",
      "name": "Archivematica Storage Service (development)",
      "protocol": "saml",
      "enabled": true,
      "rootUrl": "http://localhost:62081",
      "adminUrl": "http://localhost:62081/Shibboleth.sso/SAML2/POST",
      "redirectUris": [
        "http://localhost:62081/Shibboleth.sso/*",
        "http://127.0.0.1:62081/Shibboleth.sso/*"
      ],
      "frontchannelLogout": false,
      "attributes": {
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true",
        "saml_name_id_format": "username",
        "saml_force_name_id_format": "true",
        "saml_assertion_consumer_url_post": "http://localhost:62081/Shibboleth.sso/SAML2/POST"
      },
      "defaultClientScopes": [
        "archivematica-attributes"
      ],
      "optionalClientScopes": []
    }
  ],
  "groups": [
    {
      "name": "preservation-user",
      "path": "/preservation-user",
      "attributes": {
        "entitlement": [
          "preservation-user"
        ]
      }
    },
    {
      "name": "preservation-reviewer",
      "path": "/preservation-reviewer",
      "attributes": {
        "entitlement": [
          "preservation-reviewer"
        ]
      }
    },
    {
      "name": "preservation-manager",
      "path": "/preservation-manager",
      "attributes": {
        "entitlement": [
          "preservation-manager"
        ]
      }
    },
    {
      "name": "preservation-admin",
      "path": "/preservation-admin",
      "attributes": {
        "entitlement": [
          "preservation-admin"
        ]
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "temporary": false,
          "type": "password",
          "value": "test"
        }
      ],
      "groups": [
        "/preservation-user"
      ]
    },
    {
      "username": "reviewer",
      "email": "reviewer@example.com",
      "firstName": "Reviewer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "temporary": false,
          "type": "password",
          "value": "test"
        }
      ],
      "groups": [
        "/preservation-reviewer"
      ]
    },
    {
      "username": "manager",
      "email": "manager@example.com",
      "firstName": "Manager",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "temporary": false,
          "type": "password",
          "value": "test"
        }
      ],
      "groups": [
        "/preservation-manager",
        "/preservation-reviewer"
      ]
    },
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "temporary": false,
          "type": "password",
          "value": "test"
        }
      ],
